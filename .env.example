# Copiez ce fichier en .env et adaptez les valeurs. Ne versionnez JAMAIS .env.
# Phase 0 : ces variables sont lues depuis l'environnement du processus
# (le chargement automatique du fichier .env arrivera avec l'API, phase 5).

# Niveau de journalisation : DEBUG | INFO | WARNING | ERROR | CRITICAL
DOCASSIST_LOG_LEVEL=INFO

# Dossier des données locales (PDF importés, base ChromaDB)
DOCASSIST_DATA_DIR=data

# Dossier des modèles téléchargés (python -m doc_assistant download-model)
DOCASSIST_MODELS_DIR=models

# Modèle d'embeddings multilingue, révision figée, exécution sur CPU
DOCASSIST_EMBEDDING_MODEL=intfloat/multilingual-e5-small
DOCASSIST_EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
DOCASSIST_EMBEDDING_DEVICE=cpu
DOCASSIST_EMBEDDING_BATCH_SIZE=32

# Collection ChromaDB (3 à 512 caractères [a-zA-Z0-9._-]). Changez-la si vous changez
# de modèle d'embeddings : une collection est liée à un seul modèle.
DOCASSIST_CHROMA_COLLECTION=chunks

# Fournisseur LLM : none | gemini  (none = aucun appel ; seul gemini est implémenté)
DOCASSIST_LLM_PROVIDER=none
DOCASSIST_LLM_MODEL=gemini-3.5-flash-lite
DOCASSIST_LLM_TIMEOUT_S=30
# Nouvelles tentatives sur erreurs serveur/réseau uniquement (jamais sur quota 429)
DOCASSIST_LLM_MAX_RETRIES=1
DOCASSIST_LLM_MAX_OUTPUT_TOKENS=2048

# Clé Gemini : à définir dans l'environnement de la session, JAMAIS dans un fichier versionné.
#   PowerShell : $env:GEMINI_API_KEY = "..."
# GEMINI_API_KEY=

# Découpage (tailles en caractères) et recherche
DOCASSIST_CHUNK_SIZE=800
DOCASSIST_CHUNK_OVERLAP=100
DOCASSIST_RETRIEVAL_TOP_K=5
# Chunks voisins ajoutés à chaque passage envoyé au LLM (1 = configuration retenue, E6a ;
# 0 = top-k seul, comme le run de référence)
DOCASSIST_CONTEXT_NEIGHBORS=1

# Traduction FR -> EN des questions, pour la recherche uniquement (la question d'origine reste
# celle envoyée au LLM et affichée) : none | fr-en. Expérimental, désactivée par défaut.
# Modèle local requis : python -m doc_assistant download-translation-model
DOCASSIST_QUERY_TRANSLATION=none
DOCASSIST_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-fr-en
DOCASSIST_TRANSLATION_MODEL_REVISION=c4aed37b318c763fd177aa449b44e3b783cc6c02

# Interface web (streamlit run app.py) : elle utilise l'index de DOCASSIST_DATA_DIR, comme la
# CLI. Ajout et suppression de documents depuis l'interface : true | false. Pour un déploiement
# public, mettez false (sinon tout visiteur peut modifier la bibliothèque) et choisissez un
# DOCASSIST_DATA_DIR qui ne contient pas le CV.
DOCASSIST_APP_UPLOADS=true

# Déploiement (Streamlit Community Cloud) : laissez ces deux réglages désactivés en local.
# true : télécharge le modèle d'embeddings au premier démarrage s'il est absent (révision figée).
DOCASSIST_MODEL_AUTO_DOWNLOAD=false
# Mode démonstration : dossier de PDF publics indexés au démarrage (ex. demo/documents) ;
# l'ajout et la suppression de documents sont alors toujours désactivés. Vide : désactivé.
DOCASSIST_DEMO_DOCS_DIR=
# Mode démonstration uniquement : true donne à chaque visiteur une bibliothèque privée et
# temporaire (data/sessions/, supprimée après 2 h d'inactivité ; voir docs/adr/0009). Les
# passages de ses PDF sont envoyés au LLM : laissez false tant que la question Gemini/EEE
# (docs/adr/0006) n'est pas tranchée.
DOCASSIST_SESSION_UPLOADS=false
# Limites par visiteur, vérifiées par le serveur : taille d'un PDF (1 Mo = 1 024 × 1 024
# octets ; au plus server.maxUploadSize = 20 de .streamlit/config.toml), pages d'un PDF,
# documents ajoutés par session.
DOCASSIST_UPLOAD_MAX_MB=10
DOCASSIST_UPLOAD_MAX_PAGES=50
DOCASSIST_UPLOAD_MAX_FILES=3
# Bibliothèques privées simultanées (créées au premier envoi d'un visiteur) ; au-delà, l'envoi
# est refusé et la démonstration reste disponible.
DOCASSIST_MAX_SESSIONS=20

# Bibliothèques personnelles persistantes (connexion Google, voir docs/adr/0010) : désactivées
# par défaut ; incompatibles avec DOCASSIST_SESSION_UPLOADS. Exigent la section [auth] des
# Secrets (.streamlit/secrets.toml en local, jamais versionné) et streamlit[auth].
DOCASSIST_USER_LIBRARIES=false
# Base : chroma-cloud (production) | local (<DOCASSIST_DATA_DIR>/users, développement).
DOCASSIST_USER_STORE=chroma-cloud
DOCASSIST_ACCOUNT_MAX_DOCUMENTS=20
# Par utilisateur et par jour (compteurs en mémoire : remis à zéro chaque jour et au redémarrage)
DOCASSIST_ACCOUNT_DAILY_QUESTIONS=50
DOCASSIST_ACCOUNT_DAILY_UPLOADS=20
# Bibliothèques personnelles au plus dans la base (la base Chroma Cloud doit être réservée à
# l'application : toutes ses collections comptent).
DOCASSIST_MAX_ACCOUNTS=100
# Obligatoire avec DOCASSIST_USER_LIBRARIES : adresse https:// de VOTRE notice de
# confidentialité, affichée avant tout envoi (l'application n'en fournit aucune).
DOCASSIST_PRIVACY_URL=
# Identifiants Chroma Cloud : à définir dans l'environnement ou les Secrets, JAMAIS ici.
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# Clés API (non utilisées pour l'instant)
# ANTHROPIC_API_KEY=
